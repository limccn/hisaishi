/**
 * F2 Worker configuration (design §2).
 *
 * Secrets are set with `wrangler secret put`, never written here:
 *   PINATA_JWT    optional; without it the gateway uses the offline pin adapter
 *   RPC_URL       required
 *   IPFS_GATEWAY  required (dedicated gateway only — M1-9)
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hisaishi",
  "main": "dist/worker/index.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],

  // Keep the workers.dev hostname reachable as the documented fallback. Once
  // `routes` declares a custom domain, Wrangler disables workers.dev unless
  // this is set explicitly; released clients and the pages.dev build still
  // target it until the VITE_HISAISHI_URL variable moves to api.longstone.app.
  "workers_dev": true,

  "d1_databases": [
    {
      // Bound as `DB` because that is the name the Worker reads (`env.DB`).
      // `wrangler d1 create` suggests a binding derived from the database name
      // (`hisaishi_staging`); the binding is ours to choose, and `DB` matches
      // the design's §2 bindings table.
      "binding": "DB",
      "database_name": "hisaishi-staging",
      "database_id": "3118e31b-d6d1-4efb-ab1e-79cff67eaf1a",
      "migrations_dir": "migrations"
    }
  ],

  // KV_EMB is reserved for M2 embedding sync: declared in the Bindings type,
  // never written in M1. It is deliberately NOT bound here — a placeholder id
  // would fail the deploy, and creating a namespace we never touch is cost
  // without purpose. Bind it when M2 starts writing.
  "kv_namespaces": [
    {
      "binding": "KV_HISAISHI_STAGING",
      "id": "7c50bc375e8d46eaacd9dcfa0f911cf7"
    }
  ],

  // No `vars` entry for IPFS_GATEWAY: Cloudflare rejects a plain var and a
  // secret sharing a name ("Binding name already in use", code 10053), and the
  // gateway URL belongs in a secret because it changes per deployment. RPC_URL
  // and PINATA_JWT are secrets for the same reason.

  // The gateway's public hostname. `custom_domain` needs the `longstone.app`
  // zone in the SAME Cloudflare account as this Worker; the binding takes
  // effect on the owner's next `wrangler deploy`. Keeping it in the repo (even
  // when the owner binds through the dashboard) stops the deployed route list
  // from drifting away from the committed config. Rollback: remove this entry
  // (or unbind the custom domain) and the Worker stays reachable on
  // hisaishi.<subdomain>.workers.dev.
  "routes": [
    {
      "pattern": "api.longstone.app",
      "custom_domain": true
    }
  ],

  "vars": {
    // Required. Stable per logical deployment and part of the capability hash:
    // two deployments sharing this D1 database MUST use different ids, or they
    // could select each other's staged rows. Changing it invalidates staged
    // rows until they are re-staged.
    "HISAISHI_DEPLOYMENT_ID": "hisaishi-prod-1",
    // Browser origins allowed to read/write. Loopback is always allowed; a
    // write with a present, non-listed Origin gets 403.
    //
    // Two origins during the domain migration window:
    //   https://longstone.app            — the branded app (canonical target)
    //   https://longstone-ui.pages.dev   — still required while released
    //     clients point here. longstone-ext 0.2.0 and longstone-vscode 0.2.3
    //     hardcode the pages.dev origin and already-installed copies cannot be
    //     hot-updated, so dropping it would break their staging/build calls.
    //     Remove only after those constants ship in a release AND the old
    //     versions are no longer in use. Keep in sync with the Pages project.
    "HISAISHI_ALLOWED_ORIGINS": "https://longstone.app,https://longstone-ui.pages.dev"
    // Wildcard is deliberately absent; enable it only for local development
    // with "HISAISHI_ALLOW_ANY_ORIGIN": "true".
  },

  // Edge rate limiting and WAF are dashboard/account controls, not repo
  // settings. The app-level limiter is a per-isolate cost guard; configure
  // Cloudflare rate-limiting rules for /v1/memories, /v1/batches/* and
  // /v1/content before exposing the Worker publicly (NV-2).

  "observability": {
    "enabled": true
  }
}
