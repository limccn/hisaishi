{
  "name": "@limccn/hisaishi-gateway",
  "version": "0.1.2",
  "private": false,
  "description": "Keyless memory gateway for MemoryOverEth: staging, dedup, pinning and batch construction over SQLite (F1) or Cloudflare D1/KV (F2).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limccn/hisaishi.git"
  },
  "homepage": "https://github.com/limccn/hisaishi",
  "bugs": {
    "url": "https://github.com/limccn/hisaishi/issues"
  },
  "keywords": [
    "memory",
    "ai-agent",
    "ipfs",
    "pinata",
    "cloudflare-workers",
    "sqlite"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./local": {
      "types": "./dist/local/gateway.d.ts",
      "import": "./dist/local/gateway.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    }
  },
  "bin": {
    "hisaishi-local": "./dist/local/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "wrangler.jsonc",
    "migrations"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "node --experimental-sqlite dist/local/serve.js",
    "generate:abi": "node ../../scripts/export-abi.mjs",
    "dev:worker": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "test:e2e": "node scripts/e2e-worker.mjs",
    "migrate:remote": "wrangler d1 migrations apply hisaishi-staging --remote",
    "prepublishOnly": "pnpm build && pnpm test",
    "publish:npm": "pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org/",
    "publish:gh": "pnpm publish --access public --no-git-checks --registry https://npm.pkg.github.com/",
    "pack:check": "pnpm pack"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@limccn/menhir-core": "workspace:*",
    "hono": "4.13.13",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.106.0"
  }
}